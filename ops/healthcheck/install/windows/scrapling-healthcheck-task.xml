<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>DISABLED example. Scrapling health check every 4 hours. Do not import until the once command is verified.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <Repetition>
        <Interval>PT4H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-11-08T00:00:00</StartBoundary>
      <Enabled>false</Enabled>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <Enabled>false</Enabled>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
  </Settings>
  <Actions>
    <Exec>
      <Command>python.exe</Command>
      <Arguments>-m scrapling_healthcheck once --config config\healthcheck.json</Arguments>
    </Exec>
  </Actions>
</Task>
